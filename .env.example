# Copy to .env and edit. Every value can also be a real environment variable;
# CLI flags (evaluation.py / chat_debug.py) take precedence over both.

# ---- storage -------------------------------------------------------------
STORE_BACKEND=redis_sqlite_hybrid
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=episode:{episode_id}
SQLITE_PATH=./exp_memory.db

# ---- memory hyper-parameters --------------------------------------------
RECENT_WINDOW_TURNS=4
ACTIVE_CHAIN_TOKEN_LIMIT=800
CAPACITY_MIN_MERGE=2
CAPACITY_MAX_MERGE=4
RAW_CONTEXT_TOKEN_LIMIT=4000
MAX_TOOL_ITERATIONS=4

# ---- LLM -----------------------------------------------------------------
LLM_BACKEND=ollama
MODEL_NAME=qwen2.5:7b
TEMPERATURE=0.0
OLLAMA_HOST=http://127.0.0.1:11434
# For OpenAI-compatible servers (vLLM / LM Studio / OpenAI):
# LLM_BACKEND=openai
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=EMPTY
# Optional: use a cheaper model for summarisation/compression.
# SUMMARIZER_BACKEND=ollama
# SUMMARIZER_MODEL_NAME=qwen2.5:3b

# ---- experiment ----------------------------------------------------------
DATASET_PATH=./data/sample_episodes.json
OUTPUT_CSV_PATH=./results/predictions.csv
OUTPUT_METRICS_PATH=./results/metrics.csv
OUTPUT_LOG_PATH=./results/episode_logs.jsonl
SYSTEM=three_layer
JUDGE_BACKEND=auto
LOG_LEVEL=INFO
SEED=20240501

# Prompt language: zh | en
PROMPT_LANG=zh
